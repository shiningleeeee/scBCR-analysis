#!/usr/bin/env python3
import os
import glob
from Bio import SeqIO

# === 配置 ===
INPUT_DIR = "../raw_data"
OUTPUT_FILE = "../results/01_cleaned_sequences.fasta"
MIN_LEN = 100 

def process_ab1():
    ab1_files = sorted(glob.glob(os.path.join(INPUT_DIR, "*.ab1")))
    if not ab1_files:
        print("❌ 错误: raw_data 文件夹里没有找到 .ab1 文件！")
        return

    print(f"📂 发现 {len(ab1_files)} 个 .ab1 文件，开始处理...")
    
    with open(OUTPUT_FILE, "w") as out_handle:
        count = 0
        for f in ab1_files:
            file_name = os.path.basename(f)
            # 假设文件名类似 "Cell01_Heavy.ab1"，去掉后缀作为ID
            seq_id = file_name.rsplit('.', 1)[0]
            
            try:
                # 核心步骤：abi-trim 会根据质量值切除两端
                record = SeqIO.read(f, "abi-trim")
                seq = str(record.seq)
                
                # 过滤过短序列
                if len(seq) >= MIN_LEN:
                    # 写入fasta
                    out_handle.write(f">{seq_id}\n{seq}\n")
                    count += 1
                else:
                    print(f"⚠️ 跳过短序列: {seq_id} (长度 {len(seq)})")
            except Exception as e:
                print(f"❌ 读取错误 {file_name}: {e}")

    print(f"✅ 处理完成！有效序列: {count}。结果已保存至: {OUTPUT_FILE}")

if __name__ == "__main__":
    process_ab1()
