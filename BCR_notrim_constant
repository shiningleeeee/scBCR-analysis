#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
IG_DIR="$BASE_DIR/igblast_tool"
REF_DIR="$BASE_DIR/references"
RES_DIR="$BASE_DIR/results"

mkdir -p "$IG_DIR" "$REF_DIR" "$RES_DIR"

echo "===== Step 1: 下载 IgBlast ====="
if [ ! -x "$IG_DIR/bin/igblastn" ]; then
    cd "$IG_DIR"
    wget -O ncbi-igblast.tar.gz \
        https://ftp.ncbi.nlm.nih.gov/blast/executables/igblast/release/1.22.0/ncbi-igblast-1.22.0-x64-linux.tar.gz
    tar -xzf ncbi-igblast.tar.gz --strip-components=1
    rm -f ncbi-igblast.tar.gz
else
    echo "IgBlast 已存在，跳过下载"
fi

echo "===== Step 2: 下载 IMGT 人源 V/D/J/C 参考序列 ====="
cd "$REF_DIR"

# V
[ -f IGHV.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGHV.fasta
[ -f IGKV.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGKV.fasta
[ -f IGLV.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGLV.fasta

# D
[ -f IGHD.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGHD.fasta

# J
[ -f IGHJ.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGHJ.fasta
[ -f IGKJ.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGKJ.fasta
[ -f IGLJ.fasta ] || wget https://www.imgt.org/download/V-QUEST/IMGT_V-QUEST_reference_directory/Homo_sapiens/IG/IGLJ.fasta

# C（手动准备）这里手动去下载，并对IGHC中header重复的只保留一个即可
[ -f IGHC.fasta ] || { echo "❌ 缺少 IGHC.fasta，请手动放入 references/"; exit 1; }
[ -f IGKC.fasta ] || { echo "❌ 缺少 IGKC.fasta，请手动放入 references/"; exit 1; }
[ -f IGLC.fasta ] || { echo "❌ 缺少 IGLC.fasta，请手动放入 references/"; exit 1; }

echo "===== Step 3: 合并并格式化参考序列 ====="
cat IGHV.fasta IGKV.fasta IGLV.fasta > imgt_ig_v_human_raw.fasta
cat IGHD.fasta > imgt_ig_d_human_raw.fasta
cat IGHJ.fasta IGKJ.fasta IGLJ.fasta > imgt_ig_j_human_raw.fasta
cat IGHC.fasta IGKC.fasta IGLC.fasta > imgt_ig_c_human_raw.fasta

"$IG_DIR/bin/edit_imgt_file.pl" imgt_ig_v_human_raw.fasta > imgt_ig_v_human.fa
"$IG_DIR/bin/edit_imgt_file.pl" imgt_ig_d_human_raw.fasta > imgt_ig_d_human.fa
"$IG_DIR/bin/edit_imgt_file.pl" imgt_ig_j_human_raw.fasta > imgt_ig_j_human.fa
"$IG_DIR/bin/edit_imgt_file.pl" imgt_ig_c_human_raw.fasta > imgt_ig_c_human.fa

echo "===== Step 4: 建立 BLAST 数据库 ====="
"$IG_DIR/bin/makeblastdb" -dbtype nucl -parse_seqids -in "$REF_DIR/imgt_ig_v_human.fa"
"$IG_DIR/bin/makeblastdb" -dbtype nucl -parse_seqids -in "$REF_DIR/imgt_ig_d_human.fa"
"$IG_DIR/bin/makeblastdb" -dbtype nucl -parse_seqids -in "$REF_DIR/imgt_ig_j_human.fa"
"$IG_DIR/bin/makeblastdb" -dbtype nucl -parse_seqids -in "$REF_DIR/imgt_ig_c_human.fa"

echo "===== Step 5: 运行 IgBlast（V/D/J/C 一步完成） ====="
IGDATA="$IG_DIR" \
"$IG_DIR/bin/igblastn" \
    -germline_db_V "$REF_DIR/imgt_ig_v_human.fa" \
    -germline_db_D "$REF_DIR/imgt_ig_d_human.fa" \
    -germline_db_J "$REF_DIR/imgt_ig_j_human.fa" \
    -c_region_db "$REF_DIR/imgt_ig_c_human.fa" \
    -auxiliary_data "$IG_DIR/optional_file/human_gl.aux" \
    -organism human \
    -ig_seqtype Ig \
    -domain_system imgt \
    -query "$RES_DIR/01_raw_sequences.fasta" \
    -outfmt 19 \
    -num_threads 4 \
    -out "$RES_DIR/02_igblast_airr.tsv"

echo "✅ IgBlast 完成"
echo "输出文件: $RES_DIR/02_igblast_airr.tsv"
