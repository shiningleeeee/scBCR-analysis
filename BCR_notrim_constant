#!/usr/bin/env python3
import os
import glob
from Bio import SeqIO

BASE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
INPUT_DIR = os.path.join(BASE_DIR, "raw_data")
OUTPUT_FILE = os.path.join(BASE_DIR, "results", "01_raw_sequences.fasta")
MIN_LEN = 50  # 仅过滤极短失败序列

def main():
    os.makedirs(os.path.join(BASE_DIR, "results"), exist_ok=True)

    ab1_files = sorted(glob.glob(os.path.join(INPUT_DIR, "*.ab1")))
    if not ab1_files:
        print("❌ raw_data 中没有找到 .ab1 文件")
        return

    count = 0
    with open(OUTPUT_FILE, "w") as out:
        for f in ab1_files:
            seq_id = os.path.splitext(os.path.basename(f))[0]
            try:
                record = SeqIO.read(f, "abi")   # 这里不用 abi-trim
                seq = str(record.seq).upper().replace("N", "")
                if len(seq) >= MIN_LEN:
                    out.write(f">{seq_id}\n{seq}\n")
                    count += 1
                else:
                    print(f"⚠️ 跳过过短序列: {seq_id} ({len(seq)} bp)")
            except Exception as e:
                print(f"❌ 读取失败 {seq_id}: {e}")

    print(f"✅ 完成，共输出 {count} 条序列")
    print(f"结果文件: {OUTPUT_FILE}")

if __name__ == "__main__":
    main()
