#!/usr/bin/env python3
import os
import pandas as pd

try:
    import Levenshtein
    HAS_LEV = True
except ImportError:
    HAS_LEV = False

BASE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
RES_DIR = os.path.join(BASE_DIR, "results")
INPUT_FILE = os.path.join(RES_DIR, "02_igblast_airr.tsv")

OUT_SUMMARY = os.path.join(RES_DIR, "03_clonotype_summary.csv")
OUT_CLONE_TABLE = os.path.join(RES_DIR, "03_clone_table.csv")

DIST_THRESHOLD = 0.15
MIN_CDR3_LEN = 5


def simplify_call(x):
    if pd.isna(x):
        return ""
    return str(x).split(",")[0].split("*")[0]


def chain_type(v):
    if pd.isna(v):
        return "Unknown"
    v = str(v)
    if v.startswith("IGH"):
        return "Heavy"
    if v.startswith("IGK"):
        return "Kappa"
    if v.startswith("IGL"):
        return "Lambda"
    return "Unknown"


def hamming_ratio(s1, s2):
    if not isinstance(s1, str) or not isinstance(s2, str):
        return 999
    if len(s1) != len(s2) or len(s1) == 0:
        return 999
    if HAS_LEV:
        return Levenshtein.hamming(s1, s2) / len(s1)
    return sum(c1 != c2 for c1, c2 in zip(s1, s2)) / len(s1)


def assign_clone_ids(group_df, threshold=0.15):
    group_df = group_df.copy()
    group_df["clone_id_local"] = -1

    indices = group_df.index.tolist()
    clone_counter = 1

    while indices:
        seed = indices.pop(0)
        if group_df.at[seed, "clone_id_local"] != -1:
            continue

        seed_seq = group_df.at[seed, "cdr3"]
        group_df.at[seed, "clone_id_local"] = clone_counter

        remains = []
        for idx in indices:
            dist = hamming_ratio(seed_seq, group_df.at[idx, "cdr3"])
            if dist <= threshold:
                group_df.at[idx, "clone_id_local"] = clone_counter
            else:
                remains.append(idx)

        indices = remains
        clone_counter += 1

    return group_df


def get_cell_id(x):
    x = str(x)
    if "-" in x:
        return x.split("-")[0]
    if "_" in x:
        return x.split("_")[0]
    return x


def main():
    if not os.path.exists(INPUT_FILE):
        raise FileNotFoundError(f"找不到文件: {INPUT_FILE}")

    df = pd.read_csv(INPUT_FILE, sep="\t")
    print(f"读取 IgBlast 结果: {df.shape[0]} 条")

    required_cols = ["sequence_id", "v_call", "j_call"]
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"缺少必要列: {col}")

    df["v_call_simple"] = df["v_call"].apply(simplify_call)
    df["d_call_simple"] = df["d_call"].apply(simplify_call) if "d_call" in df.columns else ""
    df["j_call_simple"] = df["j_call"].apply(simplify_call)
    df["chain_type"] = df["v_call_simple"].apply(chain_type)

    if "productive" in df.columns:
        df["productive"] = df["productive"].astype(str)
        df = df[df["productive"].isin(["T", "True", "TRUE", "true"])]
        print(f"productive 过滤后: {df.shape[0]} 条")

    # 兼容 constant 字段
    if "c_call" in df.columns:
        df["constant_call"] = df["c_call"].apply(simplify_call)
    elif "c_region" in df.columns:
        df["constant_call"] = df["c_region"].apply(simplify_call)
    else:
        df["constant_call"] = pd.NA

    heavy = df[df["chain_type"] == "Heavy"].copy()

    if "cdr3" not in heavy.columns:
        raise ValueError("缺少 cdr3 列，无法进行克隆聚类")

    heavy = heavy.dropna(subset=["cdr3", "v_call_simple", "j_call_simple"]).copy()
    heavy["cdr3"] = heavy["cdr3"].astype(str)
    heavy["cdr3_len"] = heavy["cdr3"].str.len()
    heavy = heavy[heavy["cdr3_len"] >= MIN_CDR3_LEN].copy()

    print(f"可用于重链聚类的序列数: {heavy.shape[0]}")

    if heavy.empty:
        print("⚠️ 没有可用于聚类的重链序列")
        df.to_csv(OUT_SUMMARY, index=False)
        return

    heavy["group_key"] = (
        heavy["v_call_simple"].astype(str) + "|" +
        heavy["j_call_simple"].astype(str) + "|" +
        heavy["cdr3_len"].astype(str)
    )

    clustered_groups = []
    global_clone_counter = 1

    for _, g in heavy.groupby("group_key", sort=False):
        g = g.reset_index(drop=False)
        g2 = assign_clone_ids(g, threshold=DIST_THRESHOLD)

        local_to_global = {}
        for local_id in sorted(g2["clone_id_local"].unique()):
            local_to_global[local_id] = global_clone_counter
            global_clone_counter += 1

        g2["clone_id"] = g2["clone_id_local"].map(local_to_global)
        clustered_groups.append(g2)

    heavy_clustered = pd.concat(clustered_groups, ignore_index=True)

    clone_sizes = heavy_clustered["clone_id"].value_counts().rename("clone_size").reset_index()
    clone_sizes.columns = ["clone_id", "clone_size"]
    heavy_clustered = pd.merge(heavy_clustered, clone_sizes, on="clone_id", how="left")

    heavy_clustered["cell_id"] = heavy_clustered["sequence_id"].apply(get_cell_id)

    light = df[df["chain_type"].isin(["Kappa", "Lambda"])].copy()
    light["cell_id"] = light["sequence_id"].apply(get_cell_id)

    light_keep = [c for c in [
        "cell_id", "sequence_id", "v_call_simple", "j_call_simple",
        "cdr3", "cdr3_aa", "constant_call"
    ] if c in light.columns]

    light = light[light_keep].drop_duplicates(subset=["cell_id"]).copy()

    final_df = pd.merge(
        heavy_clustered,
        light,
        on="cell_id",
        how="left",
        suffixes=("", "_light")
    )

    sort_cols = [c for c in ["clone_size", "clone_id", "sequence_id"] if c in final_df.columns]
    final_df = final_df.sort_values(sort_cols, ascending=[False, True, True])

    final_df.to_csv(OUT_SUMMARY, index=False)

    clone_table_cols = [c for c in [
        "clone_id", "clone_size", "v_call_simple", "d_call_simple",
        "j_call_simple", "cdr3", "cdr3_aa", "constant_call"
    ] if c in final_df.columns]

    clone_table = (
        final_df[clone_table_cols]
        .drop_duplicates()
        .sort_values(["clone_size", "clone_id"], ascending=[False, True])
    )
    clone_table.to_csv(OUT_CLONE_TABLE, index=False)

    print("✅ 克隆分析完成")
    print(f"总克隆数: {final_df['clone_id'].nunique()}")
    print(f"详细结果: {OUT_SUMMARY}")
    print(f"克隆汇总: {OUT_CLONE_TABLE}")


if __name__ == "__main__":
    main()
